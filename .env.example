NODE_ENV=development
BACKEND_PORT=3001
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://app_user:replace-me@localhost:5432/email_triage_db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
EXPOSE_DEMO_TOKENS=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ALLOW_SELF_REGISTRATION=false
ENABLE_REMINDER_JOB=false
ENABLE_LEGACY_PROTOTYPE_ROUTES=false
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
